# Ignore virtual environment
venv/
.env/
.venv/

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# IDE / editor configs
.vscode/
.idea/
*.swp

# Data files and caches (generated files that shouldn't be in version control)
*.pkl
*.pickle
processed_movies.pkl
similarity_cache.pkl

# Temporary files
*.tmp
*.temp

# Log files
*.log
